# Copia este archivo como ".env" y completa tus valores. ".env" NO se sube a git.

# --- Base de datos ---------------------------------------------------------------------------
# Sin DATABASE_URL la app usa SQLite local (instance/cafeteria.db): ideal para desarrollar.
# Para Supabase: panel del proyecto -> Connect -> "Connection string" -> Session pooler (o Direct).
# Reemplaza [YOUR-PASSWORD] por la contraseña de la base de datos. Si tiene caracteres especiales
# (@ : / # ? %) escríbelos codificados (por ejemplo "@" -> "%40").
#
#   DATABASE_URL=postgresql://postgres.<ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Pooler en modo transacción (puerto 6543) también funciona. Usa el usuario que trae la cadena
# ("postgres" o "postgres.<ref>"): es dueño de las tablas.
DATABASE_URL=

# --- Aplicación ------------------------------------------------------------------------------
# SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
# ADMIN_EMAIL=admin@moka.com
# ADMIN_PASSWORD=cambia-esta-contraseña
# CAFE_DEMO_DATA=0        # 0 = no cargar clientes ni pedidos de ejemplo en el primer arranque
# CAFE_HTTPS=1            # 1 = cookies de sesión sólo por HTTPS (recomendado en producción)

# --- Pruebas ---------------------------------------------------------------------------------
# Opcional: correr las pruebas contra un PostgreSQL local o de CI. Se VACÍA en cada prueba, por eso
# el nombre de la base debe contener "test". Nunca apuntes esto a tu base de Supabase real.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cafeteria_test
